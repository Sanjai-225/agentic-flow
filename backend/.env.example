# GEMINI_API_KEY is required for real LLM-powered workflow generation.
# When unset or left as the placeholder, the backend runs in MOCK DEV MODE
# with domain-aware fallback workflows (clearly labelled).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Comma-separated CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: Max LLM retry attempts for validation failures (default: 2)
# MAX_GENERATION_RETRIES=2

# Optional: Enable LLM self-review of generated workflows (default: false)
# ENABLE_WORKFLOW_REVIEW=false

# Optional: Force mock mode even when API key is set (default: auto-detected)
# MOCK_DEV_MODE=false
