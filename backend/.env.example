# GEMINI_API_KEY is required for real LLM-powered workflow generation.
# When unset or left as the placeholder, the backend runs in MOCK DEV MODE
# with domain-aware fallback workflows (clearly labelled).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Override the fallback model (default: gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: Override the reviewer model (default: gemma-4-31b-it)
# GEMINI_REVIEWER_MODEL=gemma-4-31b-it

# Optional: Comma-separated CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: Max LLM retry attempts for validation failures (default: 2)
# MAX_GENERATION_RETRIES=2

# Optional: Max correction attempts after reviewer flags issues (default: 2)
# MAX_REVIEW_CORRECTION_ATTEMPTS=2

# Optional: Enable semantic workflow review (default: true)
# ENABLE_WORKFLOW_REVIEW=true

# Optional: Force mock mode even when API key is set (default: auto-detected)
# MOCK_DEV_MODE=false
