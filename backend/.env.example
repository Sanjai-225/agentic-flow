# Agentic Flow backend environment.
# Local development: copy to backend/.env (git-ignored).   copy .env.example .env   (Windows PowerShell)
# Production (Render): set values in the Render dashboard; render.yaml declares them. Never commit real values.
# Full reference with dev/prod behaviour per variable: docs/PRODUCTION_DEPLOYMENT.md (section "Environment").
# Check any environment without printing values:   python scripts/validate_environment.py --help

# ============================================================== core / security
# development | production. 'production' refuses to start until the checks in app/core/production.py pass
# (no SQLite, https public URLs, explicit CORS origins, JWT_SECRET >= 32 chars, valid encryption key ...).
# APP_ENV=development

# Generate production values with: python scripts/generate_secrets.py
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_MINUTES=720
# Fernet key for stored credentials. Set ONCE per environment and never change it (back it up!).
# CREDENTIALS_ENCRYPTION_KEY=

# ============================================================== database
# Local default: SQLite file backend/agentic_flow.db.  Production: Supabase SESSION POOLER connection string
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# postgres:// and postgresql:// are accepted; sslmode=require is applied automatically for hosted databases.
# URL-encode special characters in the password (e.g. @ -> %40).
# DATABASE_URL=sqlite+aiosqlite:///./agentic_flow.db
# true: apply migrations at startup (local dev). Production: false + python scripts/deploy_migrations.py --apply
# DB_AUTO_MIGRATE=true
# PostgreSQL pool (ignored for SQLite). pool_size + max_overflow must stay below the pooler's client limit.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=300

# ============================================================== URLs and CORS
# Public URL of THIS backend (webhook + public form API links). On Render it defaults to RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=http://localhost:8000
# Public URL of the frontend (hosted form pages: {PUBLIC_APP_URL}/forms/<id>).
# PUBLIC_APP_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (exact match, no trailing slash).
# CORS_ORIGINS=http://localhost:3000
# Optional anchored regex for extra origins, e.g. this project's Vercel previews:
#   ^https://agentic-flow-[a-z0-9]+-<team-slug>\.vercel\.app$
# CORS_ORIGIN_REGEX=

# ============================================================== AI workflow designer (Gemini + Gemma reviewer)
# Without a real key the designer runs in clearly labelled MOCK DEV MODE.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_REVIEWER_MODEL=gemma-4-31b-it
# MAX_GENERATION_RETRIES=2
# MAX_REVIEW_CORRECTION_ATTEMPTS=2
# ENABLE_WORKFLOW_REVIEW=true
# MOCK_DEV_MODE=false

# ============================================================== AI nodes: AI Generate + AI Agent
# Users normally store their own provider keys as encrypted credentials (Credentials dialog).
# Platform keys below are used ONLY when a node selects no credential AND AI_ALLOW_PLATFORM_KEYS=true
# (default: true in development, false when APP_ENV=production). GEMINI_API_KEY doubles as the Gemini key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_ALLOW_PLATFORM_KEYS=true
# AI_MODEL_MAX_RETRIES=2
# AI_MAX_TIMEOUT_SECONDS=300
# AI_EXTRA_MODELS=[]
# AGENT_DISABLED_TOOLS=
# AGENT_ALLOW_NETWORK_TOOLS=true

# ============================================================== execution engine and triggers
# true ONLY for local development (lets HTTP nodes call localhost/private networks). Must be false in production.
# HTTP_ALLOW_PRIVATE_NETWORKS=false
# HTTP_MAX_RESPONSE_BYTES=5242880
# EXECUTION_MAX_DURATION_SECONDS=900
# WEBHOOK_MAX_BODY_BYTES=1048576
# WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# FORM_MAX_BODY_BYTES=65536
# FORM_RATE_LIMIT_PER_MINUTE=10
# SCHEDULER_ENABLED=true
# SCHEDULER_POLL_SECONDS=5
# SCHEDULE_MIN_INTERVAL_MINUTES=1
# LOOP_MAX_ITEMS=1000
