# Agentic Flow frontend environment.
# Local development: copy to .env.local (git-ignored) and adjust.
#   copy .env.example .env.local      # Windows PowerShell
# Production/preview: set these in Vercel > Project > Settings > Environment Variables (not in a file).
# Full reference: docs/PRODUCTION_DEPLOYMENT.md
#
# NEXT_PUBLIC_* values are inlined into browser JavaScript at BUILD time: they are public, must never hold
# secrets, and a change needs a redeploy. `npm run build` runs scripts/check-env.mjs to enforce this.

# Backend origin the BROWSER calls directly (no trailing slash, no /api).
#   local:       http://localhost:8000
#   production:  https://<your-render-service>.onrender.com   (the backend must list this site in CORS_ORIGINS)
# Leave empty to use the same-origin proxy (/api/* -> BACKEND_URL) instead, e.g. for Vercel preview deployments.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (never sent to the browser): backend origin for the /api proxy and the /health route.
# Defaults to NEXT_PUBLIC_API_URL, then http://127.0.0.1:8000 locally. On Vercel there is no localhost fallback.
# BACKEND_URL=http://127.0.0.1:8000
